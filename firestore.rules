rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'imshomesantu@gmail.com',
          'makarembakkala@gmail.com',
          'shomedesk@gmail.com'
        ];
    }

    function isValidOrder(data) {
      return data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() <= 64
        && data.orderType in ['ecommerce', 'curbside', 'neighborhood_delivery']
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() <= 30
        && data.paymentMethod in ['cash', 'card', 'online']
        && data.paymentStatus in ['pending', 'received']
        && data.status in ['pending', 'processing', 'ready', 'completed', 'cancelled']
        && data.totalAmount is number && data.totalAmount >= 0
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidCustomer(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.customerCode is string && data.customerCode.size() > 0 && data.customerCode.size() <= 32
        && data.phone is string && data.phone.size() <= 30
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidTranslation(data) {
      return data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128
        && data.arabicName is string && data.arabicName.size() > 0 && data.arabicName.size() <= 200
        && data.arabicCategory is string && data.arabicCategory.size() > 0 && data.arabicCategory.size() <= 100
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidProductMedia(data) {
      return data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 1000000
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidCreditSettlement(data) {
      return data.keys().hasAll([
          'id', 'customerCode', 'receiptNumber', 'receiptDateTime',
          'billTotal', 'originalCreditAmount', 'settledAmount',
          'settlementMethod', 'settledAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'customerCode', 'receiptNumber', 'receiptDateTime',
          'billTotal', 'originalCreditAmount', 'settledAmount',
          'settlementMethod', 'note', 'settledByEmail', 'settledAt', 'createdAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.customerCode is string && data.customerCode.size() > 0 && data.customerCode.size() <= 32
        && data.receiptNumber is string && data.receiptNumber.size() > 0 && data.receiptNumber.size() <= 64
        && data.receiptDateTime is string && data.receiptDateTime.size() <= 64
        && data.billTotal is number && data.billTotal >= 0
        && data.originalCreditAmount is number && data.originalCreditAmount >= 0
        && data.settledAmount is number && data.settledAmount > 0 && data.settledAmount <= 100000
        && data.settlementMethod in ['cash', 'card', 'online']
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && (!('settledByEmail' in data) || (data.settledByEmail is string && data.settledByEmail.size() <= 120))
        && data.settledAt is string && data.settledAt.size() <= 64
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidCustomerLedger(data) {
      return data.keys().hasAll([
          'customerCode', 'lastFinalizedAt', 'totalArchivedBills',
          'totalArchivedPaidAmount', 'archivedBills', 'updatedAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'customerCode', 'lastFinalizedAt', 'totalArchivedBills',
          'totalArchivedPaidAmount', 'archivedBills', 'updatedAt', 'createdAt'
        ])
        && data.customerCode is string && data.customerCode.size() > 0 && data.customerCode.size() <= 32
        && data.lastFinalizedAt is string && data.lastFinalizedAt.size() <= 64
        && data.totalArchivedBills is int && data.totalArchivedBills >= 0 && data.totalArchivedBills <= 1000000
        && data.totalArchivedPaidAmount is number && data.totalArchivedPaidAmount >= 0
        && data.archivedBills is list
        && data.archivedBills.size() <= 350
        && (data.archivedBills.size() == 0 || (
          data.archivedBills[0] is map
          && data.archivedBills[0].receiptNumber is string
          && data.archivedBills[0].receiptNumber.size() <= 64
        ))
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if isAdmin()
        || (resource.data.customerPhone is string && resource.data.customerPhone.size() > 0)
        || (resource.data.customerCode is string && resource.data.customerCode.size() > 0);

      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().status == 'pending'
        && incoming().paymentStatus == 'pending';

      allow update: if isValidId(orderId)
        && isAdmin()
        && isValidOrder(incoming())
        && incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Customers Collection (sequential Cust ID 001+ & Mobile)
    match /customers/{customerId} {
      allow get: if isValidId(customerId);
      allow list: if isAdmin()
        || (resource.data.customerCode is string && resource.data.customerCode.size() > 0)
        || (resource.data.phoneNormalized is string && resource.data.phoneNormalized.size() > 0);
      allow create: if isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isValidId(customerId) && isValidCustomer(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(customerId) && isAdmin();
    }

    // Sequential Counters Collection (atomic 001, 002, ...)
    match /counters/{counterId} {
      allow get: if isValidId(counterId) && counterId == 'customers';
      allow create: if isValidId(counterId)
        && counterId == 'customers'
        && incoming().lastSeq is int
        && incoming().lastSeq >= 1
        && incoming().lastSeq <= 100000
        && incoming().updatedAt is string && incoming().updatedAt.size() <= 64;
      allow update: if isValidId(counterId)
        && counterId == 'customers'
        && incoming().lastSeq is int
        && incoming().lastSeq > existing().lastSeq
        && incoming().lastSeq <= existing().lastSeq + 50
        && incoming().updatedAt is string && incoming().updatedAt.size() <= 64;
      allow delete: if false;
    }

    // Arabic Product Translations (Public catalog read, Admin write)
    match /product_translations/{productId} {
      allow get: if isValidId(productId);
      allow list: if request.query.limit <= 1000 || isAdmin();
      allow create, update: if isValidId(productId) && isAdmin() && isValidTranslation(incoming());
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Product custom media & overrides (Public catalog read, Admin write)
    match /product_media/{productId} {
      allow get: if isValidId(productId);
      allow list: if request.query.limit <= 1000 || isAdmin();
      allow create, update: if isValidId(productId) && isAdmin() && isValidProductMedia(incoming());
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Credit Settlements Ledger (Scoped customer read, Admin-only write/delete)
    match /credit_settlements/{settlementId} {
      allow get: if isValidId(settlementId);
      allow list: if isAdmin()
        || (resource.data.customerCode is string
          && resource.data.customerCode.size() > 0
          && request.query.limit <= 200);
      allow create: if isValidId(settlementId)
        && isAdmin()
        && isValidCreditSettlement(incoming());
      allow update: if isValidId(settlementId)
        && isAdmin()
        && isValidCreditSettlement(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(settlementId) && isAdmin();
    }

    // Compact Customer Ledger Archive (1-doc-per-customer get, Admin-only write/list)
    match /customer_ledgers/{customerCode} {
      allow get: if isValidId(customerCode);
      allow list: if isAdmin();
      allow create: if isValidId(customerCode)
        && isAdmin()
        && isValidCustomerLedger(incoming());
      allow update: if isValidId(customerCode)
        && isAdmin()
        && isValidCustomerLedger(incoming())
        && incoming().customerCode == existing().customerCode
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'lastFinalizedAt', 'totalArchivedBills', 'totalArchivedPaidAmount', 'archivedBills', 'updatedAt'
        ]);
      allow delete: if isValidId(customerCode) && isAdmin();
    }

    function isValidStoreSetting(data) {
      return data.keys().hasOnly([
          'houseDeliveryEnabled', 'whatsappNumber', 'introVideoUrl',
          'introVideoVersion', 'offersSerialized', 'catalogSyncVersion',
          'itemCount', 'itemsSerialized', 'updatedAt'
        ])
        && (!('houseDeliveryEnabled' in data) || data.houseDeliveryEnabled is bool)
        && (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 30))
        && (!('introVideoUrl' in data) || (data.introVideoUrl is string && data.introVideoUrl.size() <= 500))
        && (!('introVideoVersion' in data) || (data.introVideoVersion is string && data.introVideoVersion.size() <= 64))
        && (!('offersSerialized' in data) || (data.offersSerialized is string && data.offersSerialized.size() <= 100000))
        && (!('catalogSyncVersion' in data) || (data.catalogSyncVersion is string && data.catalogSyncVersion.size() <= 64))
        && (!('itemCount' in data) || (data.itemCount is int && data.itemCount >= 0 && data.itemCount <= 50000))
        && (!('itemsSerialized' in data) || (data.itemsSerialized is string && data.itemsSerialized.size() <= 900000))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Store Settings
    match /store_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdmin();
      allow create, update: if isValidId(settingId) && isAdmin() && isValidStoreSetting(incoming());
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // Connectivity test document
    match /test/{docId} {
      allow get: if isValidId(docId);
    }
  }
}
